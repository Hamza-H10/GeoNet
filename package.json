{
  "name": "geodesk",
  "version": "1.0.0",
  "description": "TILTMETER DATA VISUALIZATION SOFTWARE",
  "author": "HamexLabs",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",

  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron": "electron electron/main.cjs",
    "preview": "vite preview",

    "backend": "node backend/server.cjs",

    "rebuild": "electron-builder install-app-deps",
    "pack": "electron-builder",

    "lint": "eslint .",
    "postinstall": "electron-builder install-app-deps"
  },

  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@reduxjs/toolkit": "^2.8.2",
    "apexcharts": "^5.3.2",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "body-parser": "^2.2.0",
    "chart.js": "^4.5.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase": "^12.0.0",
    "jsonwebtoken": "^9.0.2",
    "plotly.js-dist-min": "^3.1.0",
    "react": "^19.1.0",
    "react-apexcharts": "^1.7.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^1.5.2",
    "react-plotly.js": "^2.6.0",
    "react-redux": "^9.2.0",
    "react-resizable-panels": "^3.0.4",
    "react-router-dom": "^7.7.1",
    "serialport": "^13.0.0",
    "waveform-data": "^4.5.2"
  },

  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/express": "^5.0.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.2.4",
    "electron-builder": "^24.13.3",
    "eslint": "^9.30.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.6"
  },

  "build": {
    "appId": "com.geodesk.app",
    "productName": "GeoDesk",

    "asar": true,

    "asarUnpack": [
      "**/better-sqlite3/**",
      "**/serialport/**",
      "**/@serialport/**"
    ],

    "directories": {
      "output": "dist"
    },

    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "!**/*.map",
      "!**/*.ts"
    ],

    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },

    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },

    "publish": null
  }
}
