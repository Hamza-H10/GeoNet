{
    "appId": "com.hamexlabs.geodesk",
    "productName": "GeoDesk",
    "files": [
        "dist/**",
        "electron/**",
        "backend/**"
    ],
    "directories": {
        "buildResources": "assets",
        "output": "release"
    },
    "win": {
        "target": [
            {
                "target": "nsis",
                "arch": ["x64"]
            }
        ],
        "icon": "assets/icon.ico",
        "publisherName": "HamexLabs",
        "verifyUpdateCodeSignature": false
    },
    "nsis": {
        "oneClick": false,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": true,
        "createStartMenuShortcut": true,
        "shortcutName": "GeoDesk"
    },
    "publish": null
}